{
    "name": "nexude-zainav/php-notes-app",
    "description": "A notes app in plain PHP 8.2: front controller, PDO + SQLite, CSRF protection and an AJAX JSON API.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "test": "phpunit",
        "lint": "@php -l src public tests"
    },
    "config": {
        "sort-packages": true
    }
}
